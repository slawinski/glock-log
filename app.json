{
  "expo": {
    "name": "triggernote",
    "slug": "triggernote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pietrucha.triggernote",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": true,
        "NSPhotoLibraryUsageDescription": "TriggerNote needs access to your photo library to attach images to firearms, ammunition, and range visit logs.",
        "NSFaceIDUsageDescription": "TriggerNote uses Face ID to protect your firearms inventory and range data.",
        "UIUserInterfaceStyle": "Dark",
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.pietrucha.triggernote",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7d64492f-b122-4fc9-9142-740e1f4e7222"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TriggerNote uses Face ID to protect your firearms inventory and range data."
        }
      ]
    ]
  }
}
